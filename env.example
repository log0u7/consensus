# ============================================================================
# Consensus configuration
# ============================================================================
# Copy to .env and fill what you need - one key is enough to start:
#   cp env.example .env
# Or let the wizard do it for you:
#   make setup        interactive (imports keys from opencode, probes, writes)
#   make setup-auto   non-interactive tuned free-tier test config
#   make setup-paid   same, but routes to normal paid OpenRouter models
#
# Everything is optional except ONE provider credential:
#   ZEN_API_KEY (free) | OPENROUTER_API_KEY | OPENAI_API_KEY |
#   ANTHROPIC_API_KEY | LOCAL_BASE_URL
# Model refs use the "provider/model-id" format everywhere.

# ----------------------------------------------------------------------------
# Docker stack (docker-compose.yml)
# ----------------------------------------------------------------------------
# Required by compose (pgvector service). `make setup-auto` generates one.
# PG_PASSWORD=changeme
# PG_USER=raguser
# PG_DB=ragdb

# ----------------------------------------------------------------------------
# Providers
# ----------------------------------------------------------------------------

# --- Zen (opencode.ai/zen, free tier) ---------------------------------------
# ZEN_API_KEY=
# ZEN_BASE_URL=https://opencode.ai/zen/v1

# --- OpenRouter (OpenAI-compatible gateway, many free models) ---------------
# OpenRouter reports real per-call cost when the app sends usage.include=true.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL) ---------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (native Messages API, ephemeral prompt caching on) -----------
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Local (llama.cpp server / Ollama / vLLM, OpenAI-compatible) ------------
# llama.cpp example: llama-server -m model.gguf --port 8080
# cache_prompt keeps the KV prefix warm between calls (llama.cpp).
# Disable with PROVIDER_EXTRA_PAYLOAD_LOCAL={} for servers that reject it.
# LOCAL_BASE_URL=http://127.0.0.1:8080
# LOCAL_API_KEY=ollama
# PROVIDER_EXTRA_PAYLOAD_LOCAL={"cache_prompt":true}
# Context window of your local model (shown in the UI, planning fallback):
# CONTEXT_WINDOW_LOCAL=32768

# Extra payload merged into every request for a provider (JSON), e.g.
# PROVIDER_EXTRA_PAYLOAD_ZEN={"top_k":40}

# TLS: path to a CA bundle, or false to skip verification (self-signed local).
# LOCAL_CA_BUNDLE=true

# ----------------------------------------------------------------------------
# Model routing
# ----------------------------------------------------------------------------
# Defaults favour free Zen models. `make setup` rewrites this section from the
# models your providers actually expose.
CODER_MODEL=zen/big-pickle
CONSENSUS_MODEL=zen/deepseek-v4-flash-free
LEAD_MODEL=zen/deepseek-v4-flash-free
# Chat/exploration model: empty -> LEAD_MODEL. Point at a local model for
# free, private exploration chats.
# CHAT_MODEL=local/qwen3-8b
# Review panel: comma-separated name:provider/model[:max_tokens].
# 2-4 DIFFERENT models make consensus meaningful.
# REVIEW_PANEL=reviewer-1:zen/big-pickle,reviewer-2:zen/deepseek-v4-flash-free
# Fallbacks when a provider fails (comma-separated "provider/model" refs):
# CODER_FALLBACK=local
# REVIEWER_FALLBACK=local
# CONSENSUS_FALLBACK=local
# LEAD_FALLBACK=local

# Max output tokens per step
# CODER_MAX_TOKENS=16384
# REVIEW_MAX_TOKENS=8192
# CONSENSUS_MAX_TOKENS=4096
# LEAD_MAX_TOKENS=32768
# CHAT_MAX_TOKENS=8192

# ----------------------------------------------------------------------------
# Low-quota degraded profile (Lead is never downgraded)
# ----------------------------------------------------------------------------
# LOW_QUOTA_MODEL=zen/big-pickle
# LOW_QUOTA_PANEL_SIZE=2
# LOW_QUOTA_PANEL=reviewer-1:zen/big-pickle,reviewer-2:zen/deepseek-v4-flash-free
# AUTO_LOW_QUOTA=1

# ----------------------------------------------------------------------------
# Rate limiting / retry (governor)
# ----------------------------------------------------------------------------
# RPM per provider, e.g. RPM_ZEN=30 (default: DEFAULT_RPM)
# DEFAULT_RPM=30
# Auto-retry on 429/503: number of attempts with a growing window
# (exponential backoff, Retry-After honored). 0 disables auto-retry.
RATE_LIMIT_MAX_RETRIES=3
# RATE_LIMIT_BASE_DELAY=2.0
# RATE_LIMIT_MAX_DELAY=60.0
# RATE_LIMIT_RETRY_STATUSES=429,503
# HTTP_TIMEOUT=600.0

# ----------------------------------------------------------------------------
# Pricing / context metering
# ----------------------------------------------------------------------------
# Prices come from OpenRouter's public catalog (no key needed), cached in
# pricing.db. Local models cost 0. Zen models: reported cost wins when the
# provider returns one, else the catalog.
# PRICING_TTL_HOURS=24
# PRICING_DB_PATH=pricing.db
# PRICING_REFRESH=1
# CONTEXT_WINDOW_ZEN=128000

# ----------------------------------------------------------------------------
# Response cache (identical prompts -> stored replies, opt-in)
# ----------------------------------------------------------------------------
# RESPONSE_CACHE=1
# CACHE_BACKEND=memory
# CACHE_DB_PATH=cache.db
# CACHE_MAX_ENTRIES=1000

# ----------------------------------------------------------------------------
# RAG (optional)
# ----------------------------------------------------------------------------
# RAG_BACKEND=pgvector
# PG_DSN=postgres://consensus:consensus@db:5432/consensus
# SQLITE_VEC_PATH=rag.db
# EMBED_PROVIDER=zen
# EMBED_MODEL=text-embedding-3-large
# EMBED_DIM=3072
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.2

# ----------------------------------------------------------------------------
# Sessions / API / limits
# ----------------------------------------------------------------------------
# SESSION_BACKEND=memory
# SESSION_TTL_SECONDS=7200
# SESSION_MAX=100
# MAX_CONCURRENT_RUNS=2
# MAX_SPEC_CHARS=20000
# MAX_MESSAGE_CHARS=8000
# MAX_ARCHIVE_FILES=50
# MAX_ARCHIVE_BYTES=10485760
# SSE_HEARTBEAT_SECONDS=15
# ALLOWED_ORIGINS=http://localhost:8800,http://127.0.0.1:8800
# LOG_LEVEL=INFO
